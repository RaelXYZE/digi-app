# digi-app environment variables
#
# This file is tracked in git and documents the required variables.
# Copy to .env.development for local dev (next dev loads it automatically),
# or set real environment variables on the production server.

# API_URL — base URL of the digi-api backend (Django/DRF).
# Server-only (never sent to the browser; CSP connect-src 'self' blocks client fetches).
# Development: http://localhost:8000 (default if unset).
# Production: set as a real environment variable BEFORE next build AND at runtime.
#   Example: API_URL=https://api.example.go.id
API_URL=http://localhost:8000

# SITE_URL — public domain of this site, for metadata, OG, sitemap, robots, JSON-LD.
# Server-only. robots.txt and sitemap.xml are generated at build time, so this
# MUST be set before next build in production.
# Development: http://localhost:3000 (default if unset).
# Production: set as a real environment variable BEFORE next build AND at runtime.
#   Example: SITE_URL=https://balmon-jayapura.go.id
SITE_URL=http://localhost:3000

# ALLOW_LOCALHOST_URLS — set to "true" ONLY for local production testing
# (next build && next start on your machine). Allows SITE_URL to be a loopback
# address in production. API_URL may always be loopback (server-to-server).
# Never set this on a real server.
# ALLOW_LOCALHOST_URLS=true

# Local production test (both shells):
#   PowerShell:
#     $env:API_URL="http://localhost:8000"; $env:SITE_URL="http://localhost:3000"; $env:ALLOW_LOCALHOST_URLS="true"; npm run build; npm run start
#     # after testing: Remove-Item Env:API_URL,Env:SITE_URL,Env:ALLOW_LOCALHOST_URLS
#   bash:
#     API_URL=http://localhost:8000 SITE_URL=http://localhost:3000 ALLOW_LOCALHOST_URLS=true npm run build && npm run start
